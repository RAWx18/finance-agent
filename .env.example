# Google settings establish user ownership. Azure and Daily settings are voice-only.
# Verified resource values and private key-retrieval steps are in docs/azureSetup.md.

# Optional deployment settings; localhost is required for the default API origin.
APP_ENV=local

# Optional: use this exact local address in the browser; API requests enforce its origin.
PUBLIC_ORIGIN=http://localhost:8000

# Required for sign-in: Google OAuth client of type Web application.
# Register exactly PUBLIC_ORIGIN/auth/callback, e.g. http://localhost:8000/auth/callback.
GOOGLE_CLIENT_ID=

# Required secret: the same Google web client's secret; never expose it to the frontend.
GOOGLE_CLIENT_SECRET=

# Required secret: a stable Fernet key (32 random bytes, URL-safe base64).
# Use 44 characters including the trailing =, not a 64-character hexadecimal string.
# Encrypts stored Google credentials. Keep it unchanged across container restarts.
# Generate privately as described in README.md; do not commit the value.
AUTH_ENCRYPTION_KEY=

# Required secret: Azure OpenAI / Foundry resource key, never a direct OpenAI key.
AZURE_OPENAI_API_KEY=

# Required non-secret: https://<resource>.openai.azure.com/openai/v1/
# Also supports https://<resource>.services.ai.azure.com/openai/v1/; root URLs normalize to v1.
# Use the base URL, not an operation URL ending in /responses or /chat/completions.
AZURE_OPENAI_ENDPOINT=

# Required secret: Daily private rooms/tokens; Daily billing is separate from Azure credits.
DAILY_API_KEY=

# Required secret: one Speech resource key for real-time STT and streaming TTS.
AZURE_SPEECH_KEY=

# Required non-secret: the matching Speech resource region, for example centralindia.
AZURE_SPEECH_REGION=

# DATA_DIR is injected as /data by Compose and backed by its sessions volume.
# Direct Python startup defaults to the repository's .data directory; an optional
# DATA_DIR environment override must point to a private writable directory.
# Assistant identity, model/deployment choice, language, voice and turn limits belong in config.toml.
